# Copie para .env e ajuste por ambiente.
# Variáveis EXPO_PUBLIC_* são embutidas no bundle — nunca coloque segredos aqui.

# URL base da API (10.0.2.2 = localhost visto do emulador Android)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Modo de teste: substitui a API pelos mocks (features/*/mock.ts) e permite
# navegar sem backend — login "admin", senha "123". Os scripts yarn dev:test
# e yarn start:test já ligam isso; deixe false (ou ausente) no uso normal.
EXPO_PUBLIC_MOCK_API=false
