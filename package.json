{
  "name": "reactnativetypescript",
  "version": "1.0.0",
  "main": "expo-router/entry.js",
  "scripts": {
    "dev": "npx expo run:android --device",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "validate": "yarn lint && yarn typecheck && yarn test && yarn audit && depcheck",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/.expo/"
    ]
  },
  "dependencies": {
    "@expo/log-box": "^57.0.0",
    "@expo/metro-runtime": "~57.0.3",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.11.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-hook-form": "^7.55.0",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.26.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "prettier": "^3.5.3",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "disableAppConfigSyncCheck": true
    }
  }
}
